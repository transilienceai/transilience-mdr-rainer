{
  "schema": "aws_attack_primitive_kb/v1",
  "version": "1.1.0",
  "description": "Generic AWS attack-primitive knowledge base: maps a misconfiguration signature to an attack primitive, MITRE ATT&CK technique, tactic, what it enables downstream, and remediation. Extend this file each engagement to make the enumerator find more/deeper chains. Signatures reference CSPM control ids and/or normalized conditions; the mapper tags findings/nodes by matching `signature.controls` and `signature.conditions`.",
  "primitives": [
    {
      "id": "ia_public_s3_read",
      "name": "Anonymous read of public S3 bucket",
      "tactic": "initial-access",
      "mitre": [
        "T1530"
      ],
      "category": "A. Initial Access",
      "default_severity": "high",
      "signature": {
        "controls": [
          "S3_PUBLIC_BUCKET_ACCESS",
          "S3_PUBLIC_POLICY",
          "S3_PUBLIC_ACL",
          "S3_BLOCK_PUBLIC_ACCESS_DISABLED"
        ],
        "conditions": [
          "node.type==s3_bucket && exposure.internet_facing"
        ]
      },
      "enables": [
        "ca_secrets_in_public_bucket",
        "co_s3_list_recon",
        "co_s3_bulk_get"
      ],
      "remediation": "Enable Block Public Access account+bucket; remove public ACL/policy; add bucket policy deny for non-org principals."
    },
    {
      "id": "ia_public_db",
      "name": "Publicly-accessible managed database",
      "tactic": "initial-access",
      "mitre": [
        "T1190"
      ],
      "category": "A. Initial Access",
      "default_severity": "critical",
      "signature": {
        "controls": [
          "RDS_PUBLIC_ACCESS",
          "REDSHIFT_PUBLIC",
          "DOCDB_PUBLIC",
          "ELASTICACHE_PUBLIC"
        ],
        "conditions": [
          "node.type in [rds_instance,redshift,documentdb,elasticache] && attributes.publicly_accessible"
        ]
      },
      "enables": [
        "co_db_dump",
        "ca_db_creds_from_db"
      ],
      "remediation": "Set PubliclyAccessible=false; move to private subnets; restrict SG to app tier; require IAM/TLS auth."
    },
    {
      "id": "ia_admin_port_open",
      "name": "SSH/RDP admin port open to 0.0.0.0/0",
      "tactic": "initial-access",
      "mitre": [
        "T1190",
        "T1110"
      ],
      "category": "A. Initial Access",
      "default_severity": "high",
      "signature": {
        "controls": [
          "EC2_PUBLIC_ADMIN_PORT"
        ],
        "conditions": [
          "exposure.ports intersects [22,3389] && exposure.cidrs contains 0.0.0.0/0"
        ]
      },
      "enables": [
        "ca_imds_theft",
        "pe_instance_role_broad"
      ],
      "remediation": "Restrict SG to VPN/SSM; adopt SSM Session Manager; remove 0.0.0.0/0 on 22/3389."
    },
    {
      "id": "ia_public_eks",
      "name": "EKS API endpoint public to 0.0.0.0/0",
      "tactic": "initial-access",
      "mitre": [
        "T1190"
      ],
      "category": "A. Initial Access",
      "default_severity": "high",
      "signature": {
        "controls": [
          "EKS_PUBLIC_API"
        ],
        "conditions": [
          "node.type==eks_cluster && exposure.cidrs contains 0.0.0.0/0"
        ]
      },
      "enables": [
        "ca_k8s_secrets",
        "pe_k8s_privileged",
        "ps_eks_daemonset"
      ],
      "remediation": "Set endpoint private or restrict publicAccessCidrs; enable authenticator + RBAC least privilege."
    },
    {
      "id": "ia_public_web_alb",
      "name": "Internet-facing app on ALB (exploit/SSRF)",
      "tactic": "initial-access",
      "mitre": [
        "T1190"
      ],
      "category": "A. Initial Access",
      "default_severity": "high",
      "signature": {
        "controls": [
          "LB_HTTP_LISTENER",
          "ALB_INTERNET_FACING"
        ],
        "conditions": [
          "node.type==alb && exposure.internet_facing"
        ]
      },
      "enables": [
        "ca_imds_theft",
        "pe_instance_role_broad"
      ],
      "remediation": "Front with WAF; enforce HTTPS; patch app; block IMDS from app via IMDSv2 hop-limit."
    },
    {
      "id": "ia_all_traffic_sg",
