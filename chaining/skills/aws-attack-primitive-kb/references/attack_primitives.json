    {
      "id": "ia_plaintext_mitm",
      "name": "Plaintext channel enabling interception",
      "tactic": "initial-access",
      "mitre": [
        "T1557"
      ],
      "category": "A. Initial Access",
      "default_severity": "medium",
      "signature": {
        "controls": [
          "CLOUDFRONT_ALLOW_HTTP",
          "CLOUDFRONT_WEAK_TLS",
          "LB_HTTP_LISTENER",
          "EC2_PUBLIC_PLAINTEXT_PORT",
          "MQTT_OPEN"
        ],
        "conditions": []
      },
      "enables": [
        "ca_intercept_plaintext"
      ],
      "remediation": "Enforce TLS1.2+; redirect HTTP->HTTPS; disable plaintext listeners."
    },
    {
      "id": "ca_static_key_theft",
      "name": "Long-lived static access key reuse",
      "tactic": "credential-access",
      "mitre": [
        "T1552.001"
      ],
      "category": "B. Credential Access",
      "default_severity": "high",
      "signature": {
        "controls": [
          "IAM_ACTIVE_ACCESS_KEY",
          "IAM_STALE_ACCESS_KEY"
        ],
        "conditions": [
          "access_key.attributes.age_days > 180 || attributes.multiple_active"
        ]
      },
      "enables": [
        "pe_iam_fullaccess",
        "lm_ci_robot_pivot",
        "co_s3_bulk_get"
      ],
      "remediation": "Rotate <90d; prefer roles/OIDC; disable unused keys; alert on off-pattern use."
    },
    {
      "id": "ca_secrets_in_public_bucket",
      "name": "Secrets harvested from public bucket (TF-state/CI/backup)",
      "tactic": "credential-access",
      "mitre": [
        "T1552.001",
        "T1530"
      ],
      "category": "B. Credential Access",
      "default_severity": "critical",
      "signature": {
        "controls": [
          "S3_PUBLIC_BUCKET_ACCESS"
        ],
        "conditions": [
          "node.attributes.name matches (tf|terraform|state|backup|cicd|pipeline|secret|git)"
        ]
      },
      "enables": [
        "ca_static_key_theft",
        "ia_public_db",
        "lm_ci_robot_pivot"
      ],
      "remediation": "Never store secrets in S3 plaintext/state; use Secrets Manager; lock the bucket."
    },
    {
